@model List<ResultDto>
@{ ViewData["Title"] = "My Results"; }
<h1 class="rd-h">My Results</h1>
<partial name="_ApiError" />
@if (!Model.Any())
{
  <div class="alert alert-secondary">No results yet — they'll appear here once organisers publish them.</div>
}
else
{
  <div class="table-responsive card rd-card">
    <table class="table align-middle mb-0">
      <thead><tr><th>Event</th><th>Date</th><th>Category</th><th>Finish time</th><th>Placing</th></tr></thead>
      <tbody>
      @foreach (var r in Model)
      {
        <tr>
          <td>@r.EventName</td>
          <td>@r.EventDate.ToString("d MMM yyyy")</td>
          <td>@(r.CategoryName ?? "—")</td>
          <td class="rd-time">@Format.Time(r.FinishTime)</td>
          <td><strong>@Format.Ordinal(r.Position)</strong>@if (r.TotalFinishers > 0) { <span class="text-muted"> out of @r.TotalFinishers finishers</span> }</td>
        </tr>
      }
      </tbody>
    </table>
  </div>
}

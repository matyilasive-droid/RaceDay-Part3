@model EventDto
<div class="card rd-card h-100">
    @if (!string.IsNullOrEmpty(Model.BannerUrl))
    {
        <img src="@Model.BannerUrl" class="rd-banner" alt="@Model.Name banner" />
    }
    else
    {
        <div class="rd-banner rd-banner-empty"><span>@Model.EventType</span></div>
    }
    <div class="card-body d-flex flex-column">
        <span class="rd-chip mb-2">@Model.EventType</span>
        <h3 class="rd-h h5">@Model.Name</h3>
        <p class="text-muted small mb-1">📅 @Model.Date.ToString("ddd d MMM yyyy, HH:mm")</p>
        <p class="text-muted small mb-1">📍 @Model.Location</p>
        <p class="text-muted small">🏁 @Model.DistanceKm km</p>
        <a class="btn btn-rd mt-auto" asp-controller="Events" asp-action="Details" asp-route-id="@Model.Id">View &amp; Enter</a>
    </div>
</div>

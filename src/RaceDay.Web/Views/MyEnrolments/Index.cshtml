@model List<EnrolmentDto>
@{ ViewData["Title"] = "My Enrolments"; }
<h1 class="rd-h">My Enrolments</h1>
<partial name="_ApiError" />
@if (!Model.Any())
{
  <div class="alert alert-secondary">You haven't entered any events yet. <a asp-controller="Home" asp-action="Index">Browse events</a></div>
}
else
{
  <div class="table-responsive card rd-card">
    <table class="table align-middle mb-0">
      <thead><tr><th>Event</th><th>Date</th><th>Category</th><th>Status</th></tr></thead>
      <tbody>
      @foreach (var e in Model)
      {
        <tr>
          <td><a asp-controller="Events" asp-action="Details" asp-route-id="@e.EventId">@e.EventName</a></td>
          <td>@e.EventDate.ToString("d MMM yyyy")</td>
          <td>@(e.CategoryName ?? "—")</td>
          <td><partial name="_StatusBadge" model="e.Status" /></td>
        </tr>
      }
      </tbody>
    </table>
  </div>
}
